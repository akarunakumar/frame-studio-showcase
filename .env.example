# =========================================================
# Frame Studio Interiors — SIMPLE SHOWCASE VERSION
# =========================================================

# ---------------------------------------------------------
# Frontend origin (for CORS) — must match wherever the
# Angular app is actually running/served from.
# ---------------------------------------------------------
FRONTEND_URL=http://localhost:4200

# ---------------------------------------------------------
# H2 database console — LOCAL/TESTING ONLY.
# Lets you browse saved enquiries at http://localhost:8090/h2-console.
# Set to false before deploying anywhere public (Render, etc.) —
# leaving this on for a live site is a real security risk.
# ---------------------------------------------------------
H2_CONSOLE_ENABLED=true

# ---------------------------------------------------------
# Email notifications — OPTIONAL.
# Leave every SMTP_* value blank and the app still works fine —
# enquiries are saved to the database either way, you just won't
# get an email when one comes in. Fill these in once you have a
# real SMTP account (Gmail App Password, SendGrid, etc.) to enable
# email notifications.
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@framestudiointeriors.com
NOTIFY_EMAIL=
